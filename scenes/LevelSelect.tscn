[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/LevelSelectScene.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/icons/plus.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/trash.png" id="3"]

[node name="LevelSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.956863, 0.945098, 0.909804, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="Title" type="Label" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
text = "네모로직"
theme_override_font_sizes/font_size = 30

[node name="Spacer" type="Control" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="NewBtn" type="Button" parent="MarginContainer/VBox/TopBar"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "새 레벨"
icon = ExtResource("2")

[node name="EmptyLabel" type="Label" parent="MarginContainer/VBox"]
layout_mode = 2
text = "저장된 레벨이 없습니다. 「새 레벨」로 첫 퍼즐을 그려 보세요."
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="MarginContainer/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="ConfirmPanel" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.45)

[node name="Center" type="CenterContainer" parent="ConfirmPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="ConfirmPanel/Center"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="ConfirmPanel/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="ConfirmLabel" type="Label" parent="ConfirmPanel/Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="ConfirmPanel/Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CancelBtn" type="Button" parent="ConfirmPanel/Center/Panel/VBox/Buttons"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_horizontal = 3
text = "취소"

[node name="DeleteBtn" type="Button" parent="ConfirmPanel/Center/Panel/VBox/Buttons"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DangerButton"
text = "삭제"
icon = ExtResource("3")

[connection signal="pressed" from="ConfirmPanel/Center/Panel/VBox/Buttons/CancelBtn" to="." method="_on_cancel_delete"]
[connection signal="pressed" from="ConfirmPanel/Center/Panel/VBox/Buttons/DeleteBtn" to="." method="_on_confirm_delete"]
[connection signal="pressed" from="MarginContainer/VBox/TopBar/NewBtn" to="." method="_on_new_pressed"]
