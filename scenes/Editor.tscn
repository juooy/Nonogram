[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/EditorScene.gd" id="1"]
[ext_resource type="Script" path="res://scripts/NGrid.gd" id="2"]

[node name="Editor" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2

[node name="Label" type="Label" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
text = "네모로직 에디터"
theme_override_font_sizes/font_size = 20

[node name="Spacer" type="Control" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SizeLabel" type="Label" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
text = "크기:"

[node name="SizeOption" type="OptionButton" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
custom_minimum_size = Vector2(120, 0)

[node name="ClearBtn" type="Button" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
text = "초기화"

[node name="PrintBtn" type="Button" parent="MarginContainer/VBox/TopBar"]
layout_mode = 2
text = "힌트 출력"

[node name="GridArea" type="ScrollContainer" parent="MarginContainer/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="NGrid" type="Control" parent="MarginContainer/VBox/GridArea"]
layout_mode = 2
script = ExtResource("2")

[node name="HintsLabel" type="Label" parent="MarginContainer/VBox"]
layout_mode = 2
text = "(그리면 힌트가 여기 표시됩니다)"
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[connection signal="pressed" from="MarginContainer/VBox/TopBar/ClearBtn" to="." method="_on_clear_pressed"]
[connection signal="pressed" from="MarginContainer/VBox/TopBar/PrintBtn" to="." method="_on_print_pressed"]
[connection signal="item_selected" from="MarginContainer/VBox/TopBar/SizeOption" to="." method="_on_size_option_item_selected"]
