[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/EditorScene.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/Board.tscn" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/back.png" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/save.png" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/play.png" id="5"]
[ext_resource type="Texture2D" path="res://assets/icons/trash.png" id="6"]

[node name="Editor" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.956863, 0.945098, 0.909804, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="HBox" type="HBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Main" type="VBoxContainer" parent="MarginContainer/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="MarginContainer/HBox/Main"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BackBtn" type="Button" parent="MarginContainer/HBox/Main/Header"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
icon = ExtResource("3")
icon_alignment = 1

[node name="HeaderLabel" type="Label" parent="MarginContainer/HBox/Main/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
text = "레벨 만들기"
vertical_alignment = 1
theme_override_font_sizes/font_size = 26

[node name="BoardArea" type="CenterContainer" parent="MarginContainer/HBox/Main"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Board" parent="MarginContainer/HBox/Main/BoardArea" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2

[node name="SidePanel" type="PanelContainer" parent="MarginContainer/HBox"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2

[node name="Tools" type="VBoxContainer" parent="MarginContainer/HBox/SidePanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="SizeOption" type="OptionButton" parent="MarginContainer/HBox/SidePanel/Tools"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
layout_mode = 2

[node name="TitleEdit" type="LineEdit" parent="MarginContainer/HBox/SidePanel/Tools"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
placeholder_text = "레벨 제목"
max_length = 40

[node name="SaveBtn" type="Button" parent="MarginContainer/HBox/SidePanel/Tools"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
