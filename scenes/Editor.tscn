[connection signal="pressed" from="MarginContainer/HBox/SidePanel/Tools/PlayBtn" to="." method="_on_play_pressed"]
[connection signal="pressed" from="MarginContainer/HBox/SidePanel/Tools/ClearBtn" to="." method="_on_clear_pressed"]
