[connection signal="pressed" from="MarginContainer/HBox/Main/Header/BackBtn" to="." method="_on_back_pressed"]
[connection signal="item_selected" from="MarginContainer/HBox/SidePanel/Tools/SizeOption" to="." method="_on_size_option_item_selected"]
