[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/GameScene.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/ui/Board.tscn" id="2"]
[ext_resource type="Texture2D" path="res://assets/icons/back.png" id="3"]
[ext_resource type="Texture2D" path="res://assets/icons/fill.png" id="4"]
[ext_resource type="Texture2D" path="res://assets/icons/mark.png" id="5"]
[ext_resource type="Texture2D" path="res://assets/icons/retry.png" id="6"]

[sub_resource type="ButtonGroup" id="pen_group"]

[node name="Game" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.956863, 0.945098, 0.909804, 1)

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="HBox" type="HBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Main" type="VBoxContainer" parent="MarginContainer/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="MarginContainer/HBox/Main"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BackBtn" type="Button" parent="MarginContainer/HBox/Main/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
icon = ExtResource("3")
icon_alignment = 1

[node name="TitleLabel" type="Label" parent="MarginContainer/HBox/Main/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 26

[node name="BoardArea" type="CenterContainer" parent="MarginContainer/HBox/Main"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Board" parent="MarginContainer/HBox/Main/BoardArea" instance=ExtResource("2")]
unique_name_in_owner = true
layout_mode = 2

[node name="SidePanel" type="PanelContainer" parent="MarginContainer/HBox"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2

[node name="Tools" type="VBoxContainer" parent="MarginContainer/HBox/SidePanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="FillBtn" type="Button" parent="MarginContainer/HBox/SidePanel/Tools"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
theme_type_variation = &"SegmentButton"
toggle_mode = true
button_group = SubResource("pen_group")
text = "채우기"
icon = ExtResource("4")

[node name="MarkBtn" type="Button" parent="MarginContainer/HBox/SidePanel/Tools"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
theme_type_variation = &"SegmentButton"
toggle_mode = true
button_group = SubResource("pen_group")
text = "X 표시"
icon = ExtResource("5")

[node name="Spacer" type="Control" parent="MarginContainer/HBox/SidePanel/Tools"]
layout_mode = 2
size_flags_vertical = 3

[node name="RetryBtn" type="Button" parent="MarginContainer/HBox/SidePanel/Tools"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
text = "처음부터"
icon = ExtResource("6")

[node name="ClearPanel" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.45)

[node name="Center" type="CenterContainer" parent="ClearPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="ClearPanel/Center"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="ClearPanel/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ClearLabel" type="Label" parent="ClearPanel/Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.164706, 0.498039, 0.478431, 1)
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1

[node name="RetryBtn" type="Button" parent="ClearPanel/Center/Panel/VBox"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
text = "다시 하기"
icon = ExtResource("6")

[node name="BackBtn" type="Button" parent="ClearPanel/Center/Panel/VBox"]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "돌아가기"
icon = ExtResource("3")

[connection signal="pressed" from="MarginContainer/HBox/Main/Header/BackBtn" to="." method="_on_back_pressed"]
[connection signal="pressed" from="MarginContainer/HBox/SidePanel/Tools/RetryBtn" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="ClearPanel/Center/Panel/VBox/RetryBtn" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="ClearPanel/Center/Panel/VBox/BackBtn" to="." method="_on_back_pressed"]
